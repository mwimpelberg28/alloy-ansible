# Ansible Vault secrets — never commit
group_vars/alloy_nodes/vault.yml
vault-password.txt
.vault_pass*

# Real inventory (host list) — use inventory.ini.example as the template
inventory.ini

# Deployment-specific local vars (Fleet Management URL, etc.) — use the example
group_vars/alloy_nodes/local.yml

# Python virtualenv (control node) — recreate from requirements.txt
.venv*/

# Claude Code local settings
.claude/

# Ansible retry files
*.retry
